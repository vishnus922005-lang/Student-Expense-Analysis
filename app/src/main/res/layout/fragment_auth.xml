<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray_bg">

    <!-- ✅ Blue Header -->
    <View
        android:id="@+id/vHeader"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:background="@color/primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ✅ Welcome text INSIDE blue header (Top/Center area) -->
    <LinearLayout
        android:id="@+id/headerTextBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/vHeader"
        app:layout_constraintBottom_toBottomOf="@id/vHeader"
        app:layout_constraintStart_toStartOf="@id/vHeader"
        app:layout_constraintEnd_toEndOf="@id/vHeader"
        app:layout_constraintVertical_bias="0.30">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your Money. Your Control."
            android:textSize="12sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- ✅ White Card (NOW placed BELOW welcome text) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAuth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="18dp"
        app:cardUseCompatPadding="true"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/headerTextBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ✅ Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/primary_blue"
                app:tabTextColor="@color/pure_black"
                app:tabSelectedTextColor="@color/primary_blue"
                app:tabIndicatorFullWidth="false"/>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pagerAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
