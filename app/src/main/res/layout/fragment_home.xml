<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/view_budget_card" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 🔵 Heading Blue -->
                <TextView
                    android:id="@+id/tvInsightTitle"
                    android:text="Smart Insights"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1976D2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- ⚫ Message Black -->
                <TextView
                    android:id="@+id/tvInsightMessage"
                    android:layout_marginTop="6dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



        
        <include
            android:id="@+id/includeSavingCardHome"
            layout="@layout/view_saving_card" />
            
        <!-- ✅ END START SAVING CONTAINER -->

        

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeeklyChallenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <include
            android:id="@+id/includeWeeklyChallenge"
            layout="@layout/item_weekly_challenge" />



        <TextView
            android:id="@+id/tvStudentExpenseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Expense"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />


        <!-- ✅ Summary Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today Spend"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTodaySpend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="₹ 0"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ✅ Space fix -->
            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transactions"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTxnCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ✅ Manual Cash Entry Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCashEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="false"
            app:cardPreventCornerOverlap="true"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cobalt_blue"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@android:color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Cash Entry"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/cobalt_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Add cash spending manually"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCashName"
                    style="@style/CashTextInputLayoutStyle"
                    android:theme="@style/CashInputTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Name (e.g., Tea, Bus, Snacks)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCashName"
                        style="@style/CashTextInputEditTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCashAmount"
                    style="@style/CashTextInputLayoutStyle"
                    android:theme="@style/CashInputTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Amount"
                    app:prefixText="₹"
                    app:prefixTextColor="#000000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCashAmount"
                        style="@style/CashTextInputEditTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <Spinner
                    android:id="@+id/spCashCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_blue_outline" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCashDate"
                    style="@style/CashTextInputLayoutStyle"
                    android:theme="@style/CashInputTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Date"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCashDate"
                        style="@style/CashTextInputEditTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanBill"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Scan Bill"
                        android:textAllCaps="false"
                        app:strokeColor="@color/cobalt_blue"
                        android:textColor="@color/cobalt_blue" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCashCancel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        app:strokeColor="@color/cobalt_blue"
                        android:textColor="@color/cobalt_blue" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCashSave"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/cobalt_blue" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    

        <!-- ✅ Import Statement Button + badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportStatement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Import Statement"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_category"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badgeImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPendingImports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pending imports: 0"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressSms"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitleExpenses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today’s Expenses"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badgeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnRecent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecent"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Recent Spending"
                    android:textAllCaps="false"
                    app:strokeColor="@color/cobalt_blue"
                    app:backgroundTint="@color/segment_bg_selector"
                    android:textColor="@color/segment_text_selector" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnknown"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Unknown"
                    android:textAllCaps="false"
                    app:strokeColor="@color/cobalt_blue"
                    app:backgroundTint="@color/segment_bg_selector"
                    android:textColor="@color/segment_text_selector" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View
                android:id="@+id/unknownIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_red_dot"
                android:visibility="gone" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="18dp"
            android:text="No expenses found. This SMS contains only the account number, so the name could not be identified. Please upload your last 6 months’ statement (Bank, GPay, PhonePe, etc.)."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
