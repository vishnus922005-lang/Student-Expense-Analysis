<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSmsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unknown-0051"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvSmsSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03:32 pm • 29 Jan 2026"
                android:textSize="12sp"
                android:textColor="#607D8B"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Right amount + edit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvSmsAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹20.00"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/cobalt_blue"/>

            <ImageView
                android:id="@+id/ivEditAll"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_edit_black"
                android:padding="4dp"
                android:contentDescription="Edit All"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/cobalt_blue"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
