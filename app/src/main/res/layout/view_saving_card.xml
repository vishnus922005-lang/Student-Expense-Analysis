<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStartSaving"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHomeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Saving"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Little savings make big dreams possible"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewStartSaving"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="View"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/cobalt_blue"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSavingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Checking saving status..."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/weeklyTrackerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- MON -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day0"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day0Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mon"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line0"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- TUE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day1Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tue"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line1"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- WED -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day2Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Wed"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line2"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- THU -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day3Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thu"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line3"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- FRI -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day4"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day4Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fri"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line4"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- SAT -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day5"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day5Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sat"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:id="@+id/line5"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/text_muted" />

            <!-- SUN -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/day6"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|center"
                        android:src="@drawable/ic_day_empty" />

                    <ImageView
                        android:id="@+id/day6Flag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_flag_done"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sun"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
