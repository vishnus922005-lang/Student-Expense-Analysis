<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TextInputLayout style (blue hint + blue stroke + light gray bg + black dropdown icon) -->
    <style name="BlueDropdownBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintTextColor">@color/cobalt_blue</item>
        <item name="boxStrokeColor">@color/cobalt_blue</item>
        <item name="boxBackgroundColor">#F2F2F2</item>
        <item name="endIconTint">@android:color/black</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <!-- AutoCompleteTextView style (force blue text always) -->
    <style name="BlueDropdownText" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="android:textColor">@color/cobalt_blue</item>
        <item name="android:textColorHint">@color/cobalt_blue</item>
        <item name="android:padding">12dp</item>

        <!-- Disable typing -->
        <item name="android:inputType">none</item>
        <item name="android:focusable">false</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:clickable">true</item>
    </style>

</resources>
